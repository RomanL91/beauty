# Скопируйте в .env рядом с docker-compose.yml.

# Ключ OpenRouter — единственное, что нужно вписать руками.
OPENROUTER_API_KEY=sk-or-...

# Модель OpenRouter для агентов мастеров (нужна поддержка tool calling).
SPIKE_MODEL=google/gemini-2.5-flash

# Сколько профилей мастеров создать.
SPIKE_MASTERS=5

# Секреты — сгенерируйте: openssl rand -hex 32
HERMES_DEFAULT_API_KEY=
SPIKE_TICKET_SECRET=

# Тег образа Hermes: stable | latest | X.Y.Z
HERMES_TAG=stable

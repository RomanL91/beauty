# Скопируйте в .env и заполните. Вложенные группы — через двойное подчёркивание.
BEAUTY_ENVIRONMENT=dev

BEAUTY_DATABASE__URL=postgresql+asyncpg://beauty:beauty@postgres:5432/beauty
BEAUTY_RABBIT__URL=amqp://guest:guest@rabbitmq:5672/

BEAUTY_TELEGRAM__BOT_TOKEN=
BEAUTY_TELEGRAM__BOT_USERNAME=beauty_auth_bot

# Не короче 32 символов: python -c 'import secrets;print(secrets.token_urlsafe(48))'
BEAUTY_AUTH__JWT_SECRET=
# Для SSO между страницами мастеров: .beautiful.kz (пусто — cookie только на хост API)
BEAUTY_AUTH__COOKIE_DOMAIN=
BEAUTY_AUTH__COOKIE_SECURE=true
# number_matching (прод) | implicit (только локальная разработка)
BEAUTY_AUTH__CONFIRMATION_POLICY=number_matching

BEAUTY_HTTP__CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?beautiful\.kz$
BEAUTY_STORAGE__ROOT=/app/var/files

# Демо (beauty seed-demo): телефон Telegram (E.164), которому открыт кабинет мастера alisa
# на http://master.localhost:8080. Пусто — кабинет демо-мастера закрыт.
BEAUTY_DEMO_OWNER_PHONE=

# Push-уведомления (Web Push). Ключи: docker compose run --rm api push keys — все три строки
# сюда; VITE_VAPID_PUBLIC_KEY попадает в сборку PWA (пересоберите web). Пусто — push выключен.
BEAUTY_PUSH__VAPID_PUBLIC_KEY=
BEAUTY_PUSH__VAPID_PRIVATE_KEY=
BEAUTY_PUSH__SUBJECT=mailto:admin@beautiful.kz
VITE_VAPID_PUBLIC_KEY=

# ИИ-администратор (docker compose --profile agent up -d). off — свободный текст ждёт мастера.
BEAUTY_AGENT__RUNTIME=off
# Ключ default-профиля Hermes (мультиплексор): openssl rand -hex 32
HERMES_DEFAULT_API_KEY=
# Модель агентов мастеров (нужен tool calling) — через OpenRouter:
BEAUTY_AGENT__PROVIDER=openrouter
BEAUTY_AGENT__MODEL=google/gemini-2.5-flash
BEAUTY_AGENT__PROVIDER_API_KEY=
# …или без ключа LLM — сценарная «модель» (добавьте --profile fake-llm):
# BEAUTY_AGENT__PROVIDER=custom
# BEAUTY_AGENT__MODEL=fake-front-desk
# BEAUTY_AGENT__BASE_URL=http://fake-llm:8090/v1
# BEAUTY_AGENT__PROVIDER_API_KEY=fake
# BEAUTY_AGENT__STREAMING=false

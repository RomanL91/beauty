# Скопируйте в .env и заполните. Вложенные группы — через двойное подчёркивание.
BEAUTY_ENVIRONMENT=dev

BEAUTY_DATABASE__URL=postgresql+asyncpg://beauty:beauty@postgres:5432/beauty
BEAUTY_RABBIT__URL=amqp://guest:guest@rabbitmq:5672/

BEAUTY_TELEGRAM__BOT_TOKEN=
BEAUTY_TELEGRAM__BOT_USERNAME=beauty_auth_bot

# Не короче 32 символов: python -c 'import secrets;print(secrets.token_urlsafe(48))'
BEAUTY_AUTH__JWT_SECRET=
# Для SSO между страницами мастеров: .beautiful.kz (пусто — cookie только на хост API)
BEAUTY_AUTH__COOKIE_DOMAIN=
BEAUTY_AUTH__COOKIE_SECURE=true
# number_matching (прод) | implicit (только локальная разработка)
BEAUTY_AUTH__CONFIRMATION_POLICY=number_matching

BEAUTY_HTTP__CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?beautiful\.kz$
BEAUTY_STORAGE__ROOT=/app/var/files

# mock — моки для всего, кроме входа; real — бэкенд для групп из VITE_REAL_API, остальное — моки.
VITE_API_MODE=mock
# 1 — замокать и вход через Telegram (без бэкенда и бота).
VITE_MOCK_AUTH=0
# Мастер по умолчанию, если в адресе нет поддомена и ?master=.
VITE_DEFAULT_MASTER=alisa
# Публичный VAPID-ключ для Web Push (пусто — подписка недоступна).
VITE_VAPID_PUBLIC_KEY=
